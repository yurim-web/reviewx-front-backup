{
  "name": "reviewx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"node mock/server.js\" \"next dev --port 3002\"",
    "dev:next": "next dev --port 3002",
    "dev:turbopack": "next dev --turbopack --port 3002",
    "build": "next build --turbopack",
    "start": "next start --port 3002",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --config=playwright-mobile-view.config.ts",
    "test:report": "playwright show-report",
    "mock": "node mock/server.js",
    "confluence:screenshots": "node scripts/playwright_confluence_screenshots.mjs",
    "test:visual": "playwright test tests/visual-applitools.spec.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@applitools/eyes-playwright": "^1.46.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/react-editor": "^3.2.3",
    "axios": "^1.13.5",
    "body-parser": "^1.20.4",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^3.0.0",
    "json-server": "^0.17.4",
    "multer": "^2.1.1",
    "next": "^15.5.4",
    "react": "19.1.0",
    "react-day-picker": "^9.11.2",
    "react-dom": "19.1.0",
    "react-is": "^19.2.3",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "@eslint/eslintrc": "^3",
    "@playwright/mcp": "^0.0.68",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-designs": "^8.2.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-webpack5": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/theming": "^8.6.14",
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^13.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.2.11",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "storybook": "^8.6.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
